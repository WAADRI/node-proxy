# =============================================================================
# Node-Proxy .gitignore
# =============================================================================

# Node.js
node_modules/

# Vue panel build output (built inside Docker / by CI)
server/web/dist/

# Logs (all runtime logs)
*.log
logs/
server/logs/
server/audit/

# SQLite databases & temp files
server/data/
*.db
*.sqlite
*.db.tmp

# Certificates & private keys
server/certs/
*.pem
*.crt
*.key
*.csr

# Local configs that may contain secrets (keep config.yaml template in repo)
config.local.yaml
*.local.yaml
.env
.env.*
!.env.example

# Client instance ID files (regenerated per instance)
client/.cn-id
client/.us-id
client/.legacy-id
client/.client-id

# Backup / editor / OS files
*.bak
*.orig
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test leftovers (never commit ad-hoc test scripts)
client/post-body.json
client/slow.log
client/slow-server.js
client/route-server.js
client/timeout-test.js

# Local ad-hoc probe/test scripts from field debugging. They are NOT part of the project and
# some contain live credentials for a real deployment, so an accidental `git add -A` must not
# pick them up. Kept out of the tree on purpose - the files themselves stay on disk.
probe_current.py
probe_httpbin.py
probe_shot.js
probe_sni.js
probe_socks5.py
test_baidu.py
test_httpbin.py
test_socks5h.py

server/openapi/generated.json
