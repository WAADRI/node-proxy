# =============================================================================
# Node-Proxy Server - .dockerignore
# Keep runtime data & secrets out of the image (COPY . . in Dockerfile)
# =============================================================================

# Runtime data / databases (mounted as volumes in docker-compose.yml)
data/
certs/
logs/
audit/
*.db
*.sqlite
*.db.tmp
*.log

# Local configs that may contain secrets
config.local.yaml
*.local.yaml
.env
.env.*

# Node modules are installed inside the Dockerfile
node_modules/
npm-debug.log

# Vue panel build output (built inside the Dockerfile builder stage)
web/dist/
web/node_modules/

# Docs / deploy files not needed in the image
deploy/
README.md

# Server lockfile stays out; the web panel ships its own lockfile so the
# Docker build can run a reproducible `npm ci` for it
/package-lock.json
