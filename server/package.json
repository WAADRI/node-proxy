{
  "name": "node-proxy-server",
  "version": "2.1.0",
  "description": "Node-Proxy Server - Distributed IP proxy with circuit breaker, routing strategies, bandwidth limiting, Prometheus metrics, SQLite persistence",
  "main": "server.ts",
  "scripts": {
    "start": "node server.ts",
    "dev": "node --watch server.ts --logging-pretty",
    "test": "node --test test/",
    "gen-cert": "node lib/tls.ts --generate",
    "docker:build": "docker build -t node-proxy-server .",
    "docker:run": "docker-compose up -d"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.4.0",
    "pino-pretty": "^11.3.0",
    "prom-client": "^15.1.0",
    "sql.js": "^1.6.2",
    "uuid": "^10.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1"
  }
}
