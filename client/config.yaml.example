# =============================================================================
# Node-Proxy Client - config.yaml.example
# 本文件由 client/lib/config-schema.ts 自动生成，请勿手改。
# 部署用法：复制为 config.yaml 后按需修改。
# issue #53：仅 server_url / auth_token 支持环境变量覆盖（SERVER_URL / AUTH_TOKEN）；
# 节点 UUID 走 CLIENT_ID 或 CLIENT_ID_FILE（缺省自动生成并持久化）；
# region / tags 可选：面板没设置时显示这里的值，面板设置后以面板为准。
# =============================================================================

# 代理服务器 WebSocket 地址
# 默认: "ws://127.0.0.1:3000/ws"
# 环境变量: SERVER_URL
server_url: ws://1.2.3.4:3000/ws

# 认证令牌（须与服务端一致，默认值不安全，生产必改）
# 默认: "node-proxy-default-token"（生产环境必改）
# 环境变量: AUTH_TOKEN
auth_token: my-secret-token

# 节点区域（可选，面板未设置时显示该值；面板设置后以面板为准）
# 默认: ""
region: cn-guangzhou

# 节点标签，逗号分隔（可选，面板未设置时显示该值；面板设置后以面板为准）
# 默认: ""
tags: cn,premium

# 断线重连初始延迟（毫秒）
# 默认: 3000
reconnect_delay: 3000

# 断线重连最大延迟（毫秒）
# 默认: 30000
max_reconnect_delay: 30000

# 重连延迟随机抖动（毫秒）
# 默认: 1000
reconnect_jitter: 1000

# 心跳间隔（毫秒）
# 默认: 15000
heartbeat_interval: 15000

# HTTP 请求超时（毫秒）
# 默认: 30000
request_timeout: 30000

# TCP 隧道建连超时（毫秒）
# 默认: 30000
tunnel_timeout: 30000

# 最大并发请求数
# 默认: 100
max_concurrent_requests: 100

# 是否校验证书（自签证书场景设 false）
# 默认: false
tls_reject_unauthorized: false
